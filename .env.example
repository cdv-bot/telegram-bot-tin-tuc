# ==========================================
# Telegram Bot Configuration
# ==========================================
TELEGRAM_BOT_TOKEN="your_bot_token_here"
TELEGRAM_CHAT_ID="your_target_chat_id_here"
TELEGRAM_ADMIN_CHAT_ID=

# ==========================================
# Scheduler Configuration
# ==========================================
CRON_SCHEDULE="30 6 * * *"
TIMEZONE="Asia/Ho_Chi_Minh"

# ==========================================
# Retry & Health Check Settings
# ==========================================
MAX_RETRIES=3
RETRY_DELAY_MS=300000
HEALTH_CHECK_INTERVAL_MS=1800000

# ==========================================
# AI Summarizer (9Router / OpenAI / Gemini)
# ==========================================
NINE_ROUTER_API_KEY=""
NINE_ROUTER_BASE_URL="http://127.0.0.1:20128/v1"
NINE_ROUTER_MODEL="ag/gemini-3.7-flash-medium"
GEMINI_API_KEY=
OPENAI_API_KEY=

# ==========================================
# News Configuration
# ==========================================
MAX_ARTICLES_PER_DIGEST=16
LOG_LEVEL="info"
