# ==========================================
# Telegram Bot Tokens (Chạy song song 2 Bot)
# ==========================================
# Bot 1: Tin tức & GitHub Trending
TELEGRAM_BOT_TOKEN="your_news_bot_token_here"

# Bot 2: Forex & Trading Limit
TELEGRAM_FOREX_BOT_TOKEN="your_forex_bot_token_here"

# ==========================================
# Telegram Room / Chat IDs
# ==========================================
TELEGRAM_CHAT_ID="your_news_chat_id_here"
TELEGRAM_FOREX_CHAT_ID="your_forex_chat_id_here"

# ==========================================
# Scheduler Configuration
# ==========================================
CRON_SCHEDULE="30 6 * * *"
TIMEZONE="Asia/Ho_Chi_Minh"

# ==========================================
# Retry & Health Check Settings
# ==========================================
MAX_RETRIES=3
RETRY_DELAY_MS=300000
HEALTH_CHECK_INTERVAL_MS=1800000

# ==========================================
# AI Summarizer (9Router)
# ==========================================
NINE_ROUTER_API_KEY=""
NINE_ROUTER_BASE_URL="http://127.0.0.1:20128/v1"
NINE_ROUTER_MODEL="ag/gemini-3.7-flash-medium"

# ==========================================
# News Configuration
# ==========================================
MAX_ARTICLES_PER_DIGEST=16

# ==========================================
# Twelve Data Realtime Market Data
# ==========================================
TWELVE_DATA_API_KEY=""
TWELVE_DATA_WS_URL="wss://ws.twelvedata.com/v1/quotes/price"
