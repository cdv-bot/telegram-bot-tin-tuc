{
  "name": "telegram-news-bot",
  "version": "1.0.0",
  "description": "Automated Telegram News Digest Bot with Daily 6:30 AM Scheduling, Smart Summarization, Retries, and Logging",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "job:run": "tsx src/cli/runJob.ts",
    "digest:now": "tsx src/cli/manualDigest.ts",
    "bot:check": "tsx src/cli/checkConnection.ts",
    "test": "vitest run"
  },
  "keywords": [
    "telegram",
    "bot",
    "news",
    "digest",
    "rss",
    "cron",
    "summarizer"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "croner": "^9.0.0",
    "dotenv": "^16.4.7",
    "grammy": "^1.34.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "rss-parser": "^3.13.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
